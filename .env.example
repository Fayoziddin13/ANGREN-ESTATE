# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL (for SEO canonical URLs and OAuth callbacks)
NEXT_PUBLIC_SITE_URL=https://angrenestate.uz

# Admin Authentication
ADMIN_JWT_SECRET=your-secure-jwt-secret-min-32-chars-long
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_EMAIL=admin@angrenestate.uz
ADMIN_USERNAME=admin

# Direct PostgreSQL connection (optional, for running migrations)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
