  "translations": [
    {
      "id": "trans-ef2343965fe6",
      "title": "Phase malumotlar va metamalumotlarni foydalanuvchilarga xak evaziga takdim etish miqdorlarini oshirish tugrisida",
      "news_id": "news-ed90732337ca",
      "summary": "O'zbekiston Respublikasi Urbanizatsiya va uy-joy bozorini barkaror rivojlantirish milliy qo'mitasi huzuridagi Kadastr agent league direktorlik buyrug'i AB reg. No 3947. Kobul Qilingan Sana 29/09/2026. Kuchga kirish sanasi 30.09.2026",
      "language": "uz",
      "created_at": "2026-10-17T18:54:35.555Z",
      "updated_at": "2026-10-17T18:54:35.555Z",
      "practical_takeaway": "Mulkdorlar va xaridorlar davlat ro‘yxatidan o‘tish va huquqiy kafolatlarni mustahkamlash tartibidan xabardor bo‘lishlari lozim.",
      "is_reviewed_by_admin": false
    },
    {
      "id": "trans-a51aaa9affc9",
      "title": "Фазовий маълумотлар ва метамаълумотларни фойдаланувчиларга ҳақ эвазига тақдим этиш миқдорларини тасдиқлаш тўғрисида",
      "news_id": "news-ed90732337ca",
      "summary": "Ўзбекистон Республикаси Урбанизация ва уй-жой бозорини барқарор ривожлантириш миллий қўмитаси ҳузуридаги Кадастр агентлиги директорининг буйруғи АВ рег. № 3947. Қабул қилинган сана 29.09.2026. Кучга кириш санаси 30.09.2026",
      "language": "ru",
      "created_at": "2026-10-17T18:54:36.106Z",
      "updated_at": "2026-10-17T18:54:36.106Z",
      "practical_takeaway": "Собственникам и покупателям важно знать обновленный порядок регистрации и правовые гарантии на имущество.",
      "is_reviewed_by_admin": false
    },
    {
      "id": "trans-cf24bdeb7433",
      "title": "Markaziyzondan voz kechib, o'tish mumkinmi? Vazirlik javob qushi",
      "news_id": "news-f19f739ebdb6",
      "summary": "Uzbekistonda quartered uy aholisi o'zboshimchalik bilan markaziy zahiradan uzilib, urniga individual jarohat kozoni o'rnata olmaydi. Qurilish va uy-zhoy kommunal hwzhaligi vazirligi bu umumiy tizimga ta'sir kilishini va qushni honadonlar issiklik ta'minotida nosozlikka olib kelishini bildirdi.",
      "language": "uz",
      "created_at": "2026-10-17T18:54:40.101Z",
      "updated_at": "2026-10-17T18:54:40.101Z",
      "practical_takeaway": "Bozordagi narx tendensiyalarini tahlil qilish obyektni foydali xarid qilish yoki sotish vaqtini to‘g‘ri tanlashga yordam beradi.",
      "is_reviewed_by_admin": false
    },
    {
      "id": "trans-c2a35364d3d7",
      "title": "Марказий иситишдан воз кечиб, иситиш қозонига ўтиш мумкинми? Вазирлик жавоб берди",
      "news_id": "news-f19f739ebdb6",
      "summary": "Ўзбекистонда кўп квартирали уй аҳолиси ўзбошимчалик билан марказий иситишдан узилиб, ўрнига индивидуал иситиш қозони ўрната олмайди. Қурилиш ва уй-жой коммунал хўжалиги вазирлиги бу умумий иситиш тизимига таъсир қилишини ва қўшни хонадонлар иссиқлик таъминотида носозликка олиб келишини билдирди.",
      "language": "ru",
      "created_at": "2026-10-17T18:54:40.580Z",
      "updated_at": "2026-10-17T18:54:40.580Z",
      "practical_takeaway": "Анализ ценовых трендов помогает выбрать наиболее выгодный момент для покупки или продажи недвижимости.",
      "is_reviewed_by_admin": false
    },
    {
      "id": "trans-40f8caacc4a4",
      "title": "Sirdaryo-2 elektr stansiyasi shu qishda Oʻzbekiston elektr tarmogʻini mustahkamlashni boshlaydi – EDF",
      "news_id": "news-7645d188dd10",
      "summary": "Fransiyaning EDF kompaniyasi 1600 MVt quvvatga ega Sirdaryo-2 elektr stansiyasi qurilishini yakunlamoqda. Kompaniya vitse-prezidentining so'zlariga ko'ra, stansiya kelgusi qishda elektr tarmog'ini mustahkamlashni boshlaydi. Shunga o'xshash quvvatga ega Surxondaryo bug'-gaz elektr stansiyasi (BGS) qurilishi 75% yakunlandi. Buxoro yaqinida shamol elektr stansiyasi loyihasi ham e'lon qilindi.",
      "language": "uz",
      "created_at": "2026-10-17T18:54:43.848Z",
      "updated_at": "2026-10-17T18:54:43.848Z",
      "practical_takeaway": "Yangi loyihalarda investitsiya qilishdan oldin quruvchining ruxsatnomalari va shaharsozlik standartlariga muvofiqligini tekshirish muhim.",
      "is_reviewed_by_admin": false
    },
    {
      "id": "trans-db910b3bc4f3",
      "title": "Электростанция «Сырдарья-2» начнёт укреплять энергосистему Узбекистана этой зимой — EDF",
      "news_id": "news-7645d188dd10",
      "summary": "Французская EDF завершает строительство \"Сырдарьи-2\" мощностью 1600 МВт. По словам вице-президента компании, станция начнёт укреплять энергосистему уже предстоящей зимой. Строительство Сурхандарьинской ПГУ такой же мощности выполнено на 75%. Также заявлено о проекте ветростанции возле Бухары.",
      "language": "ru",
      "created_at": "2026-10-17T18:54:45.199Z",
      "updated_at": "2026-10-17T18:54:45.199Z",
      "practical_takeaway": "Перед инвестициями в новостройки важно проверять разрешительную документацию и репутацию девелопера.",
      "is_reviewed_by_admin": false
    },
    {
      "id": "trans-6a25706e14e9",
      "title": "Nima uchun 500 kVt/soat emas, balki 350 kVt/soat? Iqtisodiyot va moliya vazirligi yangi elektr energiyasi standartini tanlashni tushuntirdi.",
      "news_id": "news-0a52a0e79cdb",
      "summary": "Vazir o'rinbosari Xurshed Mustafoyev qishki iste'mol tahlili asosida gazsiz hududlar uchun asosiy elektr energiyasi tarifini 200 dan 350 kVt/soatgacha oshirishni taklif qildi. Uning so'zlariga ko'ra, uy xo'jaliklarining 60 foizi 300 kVt/soatgacha elektr energiyasi iste'mol qiladi. Ushbu chora gazsiz hududlardagi abonentlarning taxminan 80 foizini qamrab olishi kutilmoqda.",
      "language": "uz",
      "created_at": "2026-10-17T18:54:47.227Z",
      "updated_at": "2026-10-17T18:54:47.227Z",
      "practical_takeaway": "Bozordagi narx tendensiyalarini tahlil qilish obyektni foydali xarid qilish yoki sotish vaqtini to‘g‘ri tanlashga yordam beradi.",
      "is_reviewed_by_admin": false
    },
    {
      "id": "trans-a0626f76e12c",
      "title": "Почему 350, а не 500 кВт·ч? Минэкономфин объяснил выбор новой нормы электроэнергии",
      "news_id": "news-0a52a0e79cdb",
      "summary": "Базовую норму электроэнергии для районов без газа предложили увеличить с 200 до 350 кВт·ч на основе анализа зимнего потребления, сообщил замминистра Хуршед Мустафаев. По его словам, 60% домохозяйств расходует до 300 кВт·ч. Ожидается, что мера охватит около 80% абонентов на территориях без газа.",
      "language": "ru",
      "created_at": "2026-10-17T18:54:47.673Z",
      "updated_at": "2026-10-17T18:54:47.673Z",
