# ANGREN ESTATE — local test environment template (TEST Supabase project only)
#
# Copy this file to BOTH of these names (both are git-ignored):
#   .env.test.local          -> read by `npm test` (vitest)
#   .env.development.local   -> read by `npm run dev`
# Then paste the keys of the test project "angren-estate-test" from the Supabase
# dashboard (Project Settings -> API Keys). Never paste production keys here.
#
# Safety nets:
#   - tests, seeds and Mock payments refuse to run unless the URL below is an
#     allow-listed test project (src/lib/env/safety.ts);
#   - `next dev` refuses to start against production (next.config.mjs).

NEXT_PUBLIC_SUPABASE_URL=https://lesaumhlzjagrcfvjqqf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local admin login for the dev server. Use your own local values, not production ones.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Mock payment provider: works only locally and only against the test project.
MOCK_PAYMENTS=1

# Leave TELEGRAM_BOT_TOKEN unset (or use a separate test bot). Never use the production bot token.
